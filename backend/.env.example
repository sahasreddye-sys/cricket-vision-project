# Copy to backend/.env and edit. Never commit .env.

# Database. Default is a local SQLite file (backend/pitchvision.db).
# PostgreSQL:  postgresql+psycopg://USER:PASSWORD@HOST:5432/pitchvision
# Supabase:    postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# PITCHVISION_DATABASE_URL=

# Key used to sign login tokens. If left empty a random key is generated and
# stored in backend/.secret_key on first start.
# PITCHVISION_SECRET_KEY=

# PITCHVISION_MAX_UPLOAD_MB=200
# PITCHVISION_CORS_ORIGINS=http://localhost:5173

# Optional: lets the AI Coach phrase answers with Claude. Without it the
# built-in rule-based coach is used.
# ANTHROPIC_API_KEY=
# PITCHVISION_LLM_MODEL=claude-opus-5-5
